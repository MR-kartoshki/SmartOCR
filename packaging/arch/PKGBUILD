pkgname=smartocr
pkgver=1.0.0
pkgrel=1
pkgdesc='Fast local OCR CLI using PaddleOCR and ONNX Runtime'
arch=('x86_64')
url='https://github.com/MR-kartoshki/SmartOCR'
license=('MIT')
depends=(
  'python'
  'python-paddleocr'
  'python-onnxruntime'
)
makedepends=(
  'python-build'
  'python-installer'
  'python-setuptools'
)
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('4dc477c79464a73d73f83d6a7b1ae56b63e46488eef34643db9c0ccc08dedd1f')

build() {
  cd "SmartOCR-$pkgver"
  python -m build --wheel --no-isolation
}

package() {
  cd "SmartOCR-$pkgver"
  python -m installer --destdir="$pkgdir" dist/*.whl
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
