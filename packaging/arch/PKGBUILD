pkgname=smartocr
pkgver=1.1.0
pkgrel=1
pkgdesc='Fast local OCR CLI using RapidOCR and ONNX Runtime'
arch=('x86_64')
url='https://github.com/MR-kartoshki/SmartOCR'
license=('MIT')
depends=(
  'python'
  'python-rapidocr'
  'python-onnxruntime'
  'python-pymupdf'
)
makedepends=(
  'python-build'
  'python-installer'
  'python-setuptools'
)
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('31582d184ea16c3830882e589c2273c800733a22506a6d9dd613da64a4834d81')

build() {
  cd "SmartOCR-$pkgver"
  python -m build --wheel --no-isolation
}

check() {
  cd "SmartOCR-$pkgver"
  python -m unittest discover -s tests -v
}

package() {
  cd "SmartOCR-$pkgver"
  python -m installer --destdir="$pkgdir" dist/*.whl
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
